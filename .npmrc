# The devDependencies pin Storybook 10 while @storybook/addon-essentials is 8.x,
# which makes a strict peer-dependency resolver (npm 7+) fail with ERESOLVE.
# This repo ships as static HTML in public/; the Node toolchain is only used by
# helper scripts. Allow legacy peer resolution so any `npm install` / `npm ci`
# (Cloudflare Workers Builds, Codespaces prebuilds, local dev) succeeds instead
# of aborting the whole build on the Storybook peer conflict.
legacy-peer-deps=true
