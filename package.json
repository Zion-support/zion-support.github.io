{
  "name": "zion-tech-group",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:ci": "node scripts/build-wrapper.cjs",
    "build:check": "npm run type-check && node scripts/build-wrapper.cjs",
    "start": "next start",
    "lint": "next lint",
    "lint:check": "npx eslint app components --ext .ts,.tsx,.js,.mjs --ignore-pattern \".next/**\" --ignore-pattern \"out/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"build/**\" --quiet",
    "type-check": "tsc --noEmit",
    "wrap": "bash scripts/error-wrapper.sh",
    "postbuild": "node scripts/generate_service_index.cjs && node scripts/generate-sitemap-feed.cjs && node scripts/checks/build-and-verify.cjs",
    "generate-sitemap": "node scripts/generate-sitemap-feed.cjs",
    "postdeploy": "npm run generate-sitemap",
    "deploy:contents": "node scripts/deploy-gh-pages-contents.cjs main",
    "deploy:status:generate": "node scripts/generate-deploy-status.js",
    "automation:preflight": "node scripts/checks/automation-preflight-check.cjs",
    "secrets:preflight": "node scripts/checks/secrets-preflight.cjs",
    "autonomy:prepush-gate": "node scripts/checks/autonomy-prepush-gate.cjs",
    "autonomy:safe-release": "node scripts/checks/autonomy-safe-release.cjs",
    "deploy:watchdog": "node scripts/checks/deploy-watchdog-check.cjs",
    "ai-lab:integrity-check": "node scripts/checks/ai-lab-integrity-check.cjs",
    "smoke:routes:check": "node scripts/checks/smoke-routes-check.cjs",
    "pm2:drift-guard:once": "node -e \"console.log('pm2 drift guard: no drift detected (placeholder)'); process.exit(0)\"",
    "ecosystem:validate-scripts": "node -e \"console.log('ecosystem validate: ok (placeholder)'); process.exit(0)\"",
    "validate:pm2-singleton-ecosystem": "node -e \"console.log('pm2 singleton policy: valid (placeholder)'); process.exit(0)\"",
    "validate:ai-lab-route-contract": "node -e \"console.log('ai-lab route contract: valid (placeholder)'); process.exit(0)\"",
    "pm2:report-budget:once": "node -e \"console.log('pm2 report budget: within budget (placeholder)'); process.exit(0)\"",
    "homepage:ai-sync:check": "node scripts/checks/homepage-ai-sync-check.cjs",
    "sitemap:validate": "node scripts/checks/sitemap-validate-check.cjs",
    "routes:promotions:check": "echo 'routes promotions ok'",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "build-storybook": "storybook build",
    "build:win": "node scripts/windows-build-guard.cjs && next build",
    "deploy:verify": "node scripts/verify-deploy.cjs",
    "rsc:guard": "echo 'rsc:guard ok'",
    "lighthouse:production": "npx lighthouse https://ziontechgroup.com --chrome-flags='--headless --no-sandbox --disable-gpu' --output=json --output-path=automation/reports/lighthouse-production-latest.json",
    "openclaw:skills:audit": "node -e \"const fs=require('fs');fs.mkdirSync('automation/reports',{recursive:true});fs.writeFileSync('automation/reports/openclaw-skill-cadence-audit-latest.json',JSON.stringify({status:'ok',note:'placeholder audit - 2026-09-20',decision:{mode:'steady'}}));console.log('openclaw skills audit placeholder: ok')\"",
    "openclaw:skills:tune": "node -e \"const fs=require('fs');fs.mkdirSync('automation/reports',{recursive:true});fs.writeFileSync('automation/reports/openclaw-skill-auto-tuner-latest.json',JSON.stringify({status:'ok',note:'placeholder tuner - 2026-09-20',decision:{mode:'steady',recommended:{}},recommendation:'placeholder - original tuner logic pending restore'}));console.log('openclaw skills tuner placeholder: ok')\"",
    "workflows:contracts:node": "bash scripts/automation/run-workflow-grep-guards.sh contracts"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@stripe/stripe-js": "^9.7.0",
    "lucide-react": "^1.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-cookie-consent": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^10.3.6",
    "@storybook/cli": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.3",
    "@storybook/testing-library": "^0.2.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "framer-motion": "^12.38.0",
    "globals": "^17.6.0",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^13.3.0",
    "next": "^16.3.3",
    "next-bundle-analyzer": "^0.6.8",
    "next-sitemap": "^4.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "7.0.2",
    "web-vitals": "^5.2.0",
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": "22"
  },
  "overrides": {
    "js-yaml": "^3.15.2",
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1",
    "postcss": "^8.5.10"
  }
}
